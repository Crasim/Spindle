{
  "manifest_version": 3,
  "name": "Spindle Browser Link",
  "description": "Connect the active browser tab to Spindle using your website and model permissions.",
  "version": "0.5.8",
  "key": "",
  "minimum_chrome_version": "116",
  "permissions": ["nativeMessaging", "scripting", "tabs", "tabGroups", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "icons": { "256": "icon.png" },
  "action": { "default_popup": "popup.html", "default_icon": { "256": "icon.png" } },
  "background": { "service_worker": "background.js" }
}
